{
  "name": "webkit-ohos",
  "version-string": "2.50.0",
  "description": "Third-party dependencies of the WPE WebKit OpenHarmony port (arm64-ohos).",
  "dependencies": [
    "cairo",
    "freetype",
    "gettext-libintl",
    {
      "name": "glib",
      "host": true
    },
    {
      "name": "harfbuzz",
      "features": [
        "icu"
      ]
    },
    "icu",
    "libepoxy",
    "libgcrypt",
    "libjpeg-turbo",
    "libpng",
    "libpsl",
    "libsoup",
    "libtasn1",
    "libwebp",
    "libwpe",
    "libxml2",
    "libxslt",
    "openjpeg",
    "sqlite3",
    "zlib"
  ],
  "default-features": [
    "media"
  ],
  "features": {
    "media": {
      "description": "GStreamer-based media playback (USE_GSTREAMER_GL=ON) with the codec plugin set.",
      "dependencies": [
        {
          "name": "gstreamer",
          "default-features": false,
          "features": [
            "gl",
            "ogg",
            "openh264",
            "openjpeg",
            "opus-base",
            "opus-bad",
            "plugins-bad",
            "plugins-base",
            "plugins-good",
            "vorbis",
            "vpx",
            "webp"
          ]
        }
      ]
    }
  },
